# ==============================================================================
# Royal V Properties — Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and configure values before starting.
# NEVER commit the real .env file with production secrets into version control.

# --- Application Runtime ---
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database Connection (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local Docker: postgresql://postgres:postgres_royalv_pass@localhost:5432/royal_v_properties?schema=public
DATABASE_URL="postgresql://postgres:postgres_royalv_pass@localhost:5432/royal_v_properties?schema=public"

# --- Authentication & Session Security ---
# Generate a cryptographically secure 32+ character key:
# Run: openssl rand -base64 32
AUTH_SECRET="royalv_development_super_secret_session_key_replace_in_production_min_32_chars"
AUTH_COOKIE_NAME="royalv_session"
AUTH_SESSION_EXPIRY_DAYS="7"

# --- Initial Seed Credentials (Used only on initial database seed) ---
INITIAL_SUPER_ADMIN_NAME="Royal V Admin"
INITIAL_SUPER_ADMIN_EMAIL="royalvproperties@gmail.com"
INITIAL_SUPER_ADMIN_PHONE="+91 98858 39645"
INITIAL_SUPER_ADMIN_PASSWORD="Admin@RoyalV2006!"

# --- Contact & Customer Support Channels ---
CONTACT_PHONE="+91 98858 39645"
CONTACT_SECONDARY_PHONES="+91 97000 71279, +91 94917 96224"
WHATSAPP_NUMBER="919885839645"
CONTACT_EMAIL="royalvproperties@gmail.com"

# --- Storage Configuration (local / s3 / r2) ---
STORAGE_DRIVER="local"
UPLOAD_MAX_SIZE_MB="5"
# S3_BUCKET_NAME=""
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Brand Metadata ---
NEXT_PUBLIC_COMPANY_NAME="Royal V Properties"
NEXT_PUBLIC_ESTABLISHED_YEAR="2006"
NEXT_PUBLIC_PRIMARY_OFFICE="SVN Colony, Guntur, Andhra Pradesh, India"
NEXT_PUBLIC_SERVICE_REGIONS="Guntur, Vijayawada, Amaravati, Mangalagiri, Tadepalli, Tenali"
