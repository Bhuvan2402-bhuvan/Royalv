# ==============================================================================
# Royal V Properties — Production Environment Configuration Template
# Target Production Domain: https://royalv.varunyatech.in
# ==============================================================================
# Instructions: Copy this template to .env on the server and supply production secrets.
# In Docker Compose, POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB are the single
# source of truth and are automatically assembled into DATABASE_URL for the web service.
# NEVER commit the real .env file with production credentials into version control.

# --- Application Runtime ---
NODE_ENV="production"
PORT="3000"
NEXT_PUBLIC_SITE_URL="https://royalv.varunyatech.in"

# --- Database Credentials (Single Source of Truth) ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD"
POSTGRES_DB="royal_v_properties"

# --- Database URL (Optional in Docker Compose; automatically built from POSTGRES_* above) ---
# DATABASE_URL="postgresql://postgres:CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD@postgres:5432/royal_v_properties?schema=public"

# --- Authentication & Session Security ---
# Generate a cryptographically secure 32+ character key using: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
AUTH_COOKIE_NAME="royalv_session"
AUTH_SESSION_EXPIRY_DAYS="7"

# --- Initial Super Admin Bootstrap Credentials ---
# Used strictly by 'npm run db:init-admin' during initial production setup
INITIAL_SUPER_ADMIN_NAME="Executive Admin"
INITIAL_SUPER_ADMIN_EMAIL="admin@yourdomain.com"
INITIAL_SUPER_ADMIN_PHONE="+91 9XXXXXXXXX"
INITIAL_SUPER_ADMIN_PASSWORD="CHANGE_ME_TO_STRONG_INITIAL_ADMIN_PASSWORD"

# --- Contact & Public Channels (Customizable) ---
CONTACT_PHONE="+91 9XXXXXXXXX"
CONTACT_SECONDARY_PHONES="+91 9XXXXXXXXX"
WHATSAPP_NUMBER="919XXXXXXXXX"
CONTACT_EMAIL="contact@yourdomain.com"

# --- Storage Engine Configuration ---
STORAGE_DRIVER="local"
UPLOAD_MAX_SIZE_MB="5"
# S3_BUCKET_NAME=""
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Brand Metadata ---
NEXT_PUBLIC_COMPANY_NAME="Royal V Properties"
NEXT_PUBLIC_ESTABLISHED_YEAR="2006"
NEXT_PUBLIC_PRIMARY_OFFICE="SVN Colony, Guntur, Andhra Pradesh, India"
NEXT_PUBLIC_SERVICE_REGIONS="Guntur, Vijayawada, Amaravati, Mangalagiri, Tadepalli, Tenali"
